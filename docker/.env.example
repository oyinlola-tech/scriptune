# Host ports for the local stack. Change these if something else already
# listens on the defaults.
POSTGRES_PORT=5432
REDIS_PORT=6379
TRANSCRIBER_PORT=5005

# Only used by the optional `api` service (--profile api).
WEB_ORIGIN=http://localhost:3000
AUTH_ACCESS_SECRET=change-me-to-a-long-random-string-of-32-plus-chars
AUTH_REFRESH_SECRET=change-me-to-a-different-long-random-string-32-plus
