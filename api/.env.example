# Runtime
NODE_ENV=development
HOST=0.0.0.0
PORT=4000
PUBLIC_URL=http://localhost:4000
LOG_LEVEL=debug

# Database (matches docker/compose.yml)
DATABASE_URL=postgresql://scriptune:scriptune@localhost:5432/scriptune

# Web app origins allowed by CORS (comma separated)
WEB_ORIGIN=http://localhost:3000

# Number of reverse-proxy hops to trust for client IPs (0 = none)
TRUST_PROXY=0

# Global rate limit per client IP
RATE_LIMIT_MAX=300
RATE_LIMIT_WINDOW_MS=60000

# Speech to text runs locally with OpenAI Whisper (see transcriber/). WHISPER_URL is
# where that service listens; set TRANSCRIPTION_PROVIDER=none to turn audio off, or
# =fake only for local development and tests.
WHISPER_URL=http://localhost:5005
WHISPER_TIMEOUT_MS=60000
# TRANSCRIPTION_PROVIDER=whisper|fake|none (default: whisper)

# Recognition
RECOGNITION_RATE_LIMIT_MAX=30
DEFAULT_TRANSLATION=KJV

# Authentication. Secrets must be at least 32 characters and differ from each other.
AUTH_ACCESS_SECRET=change-me-to-a-long-random-string-of-32-plus-chars
AUTH_REFRESH_SECRET=change-me-to-a-different-long-random-string-32-plus
AUTH_ACCESS_TTL_SECONDS=900
AUTH_REFRESH_TTL_SECONDS=2592000
AUTH_SESSION_TTL_SECONDS=2592000

# Google sign-in (optional). Authorized redirect URI: ${PUBLIC_URL}/auth/google/callback
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
WEB_AUTH_CALLBACK_PATH=/auth/callback
# Deep link the mobile app opens to finish Google sign-in (must use the app scheme, never http).
MOBILE_AUTH_CALLBACK_URL=scriptune://auth/callback
